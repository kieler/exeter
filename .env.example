# Copy to .env.local and replace the CHANGEME values and example URLs.
# Keep .env.local private. Single quotes keep dollar signs in secrets literal.

# PostgreSQL. Generate a password with: openssl rand -hex 32
POSTGRES_USER=exeter
POSTGRES_DB=exeter
POSTGRES_PASSWORD='CHANGEME_DATABASE_PASSWORD'
# Use the same user, database, and password here. URL-encode special characters.
DATABASE_URL='postgresql://exeter:CHANGEME_DATABASE_PASSWORD@database:5432/exeter?schema=public'

# Public app URLs and authentication. Generate a separate auth secret.
BETTER_AUTH_URL=https://exeter.example.org
EXETER_BASE_URL=https://exeter.example.org
BETTER_AUTH_SECRET='CHANGEME_AUTH_SECRET'

# Initial administrator for an empty database. Use a password of 8–128 characters.
# These can be left empty after the first account has been created.
ADMIN_EMAIL_INITIAL=admin@example.org
ADMIN_PASSWORD_INITIAL='CHANGEME_ADMIN_PASSWORD'

# Browser-facing WebSocket URL. The host reverse proxy must forward /socket.
KLIGHD_WEBSOCKET_URL=wss://exeter.example.org/socket

# Internal service settings. If you change PROXY_PORT, update both internal URLs
# and the container-side proxy port in docker-compose.yml.
KLIGHD_SERVER_WEBSOCKET_URL=ws://language-server-ws-proxy:8000/socket
KLIGHD_HEALTH_URL=http://language-server-ws-proxy:8000/health
PROXY_PORT=8000
LSP_HOST=language-server
LSP_PORT=5007
