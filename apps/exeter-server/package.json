{
  "name": "exeter-server",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "infra:up": "mkdir -p diagram-sources && docker compose --env-file .env.local -f docker-compose.dev.yaml up -d --wait && pnpm run prisma:client:generate && pnpm run prisma:migrate",
    "infra:down": "docker compose --env-file .env.local -f docker-compose.dev.yaml down",
    "test:infra:up": "docker compose -f ../../docker-compose.test.yml up -d --build",
    "test:infra:down": "docker compose -f ../../docker-compose.test.yml down",
    "prisma:client:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migration:generate": "prisma migrate dev --create-only",
    "test:integration": "APP_ENV=test pnpm run prisma:client:generate && APP_ENV=test pnpm run prisma:migrate && APP_ENV=test vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@kieler/klighd-core": "^0.8.1",
    "@kieler/klighd-instrumentation": "file:./kieler-klighd-instrumentation-0.1.0.tgz",
    "@kieler/klighd-interactive": "^0.8.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@mui/x-charts": "^9.18.1",
    "@mui/x-data-grid": "^9.18.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.27",
    "jsdom": "^30.1.3",
    "next": "16.2.10",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "reflect-metadata": "0.2.2",
    "rrweb-player": "^2.2.2",
    "sprotty": "^1.4.0",
    "ua-parser-js": "^2.0.10",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
