# WebSocket endpoint for the KLighD language-server proxy.
KLIGHD_WEBSOCKET_URL=ws://localhost:8000/socket
KLIGHD_SERVER_WEBSOCKET_URL=ws://language-server-ws-proxy:8000/socket
# Server-side URL for the proxy health endpoint, resolved through Docker service DNS.
KLIGHD_HEALTH_URL=http://language-server-ws-proxy:8000/health

# PostgreSQL credentials for the local Docker Compose database.
POSTGRES_USER=exeter
POSTGRES_PASSWORD=change-me
POSTGRES_DB=exeter
DATABASE_URL=postgresql://exeter:change-me@database:5432/exeter?schema=public

# Better Auth server configuration.
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# Initial administrator for an empty database.
ADMIN_EMAIL_INITIAL=admin@example.org
ADMIN_PASSWORD_INITIAL=nopassnopass

# Next.js Config
NEXT_TELEMETRY_DISABLED=1

# General App Configuration
EXETER_BASE_URL=http://localhost:3000
